                    systemInstruction: { parts: [{ text: systemInstruction }] },
                    generationConfig: {
                        responseMimeType: "application/json",
                        temperature: 0.2
                    }
                };

                try {
                    const response = await fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        const errData = await response.json().catch(() => ({}));
                        const errMsg = errData?.error?.message || `HTTP error! status: ${response.status}`;
                        throw new Error(errMsg);
                    }

                    const data = await response.json();
                    
                    if (data.candidates && data.candidates.length > 0) {
                        const rawText = data.candidates[0].content.parts[0].text;
                        const cleanedText = sanitizeJSON(rawText);
                        
                        try {
                            const parsedData = JSON.parse(cleanedText);
                            setResult(parsedData);
                            setActiveTab("alur");
                        } catch (parseErr) {
                            console.error("Parse error. Raw AI Output:", rawText);
                            setError("Format data dari AI tidak sesuai standar JSON. Silakan coba klik tombol generate lagi.");
                        }
                    } else {
                        setError("AI tidak mengembalikan hasil yang valid.");
                    }
                } catch (err) {
                    console.error("API Fetch Error:", err);
                    if (err.message.includes("API key not valid")) {
                        setError("API Key tidak valid. Lingkungan eksekusi mungkin tidak menyediakan key yang valid.");
                    } else {
                        setError(`Gagal terhubung ke AI. Detail: ${err.message}`);
                    }
                } finally {
                    setIsGenerating(false);
                }
            };

            const handleOrderChange = (kelasIdx, semesterType, currentItemIdx, targetItemIdx) => {
                if (currentItemIdx === targetItemIdx) return;
                setResult(prevResult => {
                    if (!prevResult) return prevResult;
                    const newResult = { ...prevResult };
                    const newPembagianKelas = [...newResult.pembagian_kelas];
                    const targetKelas = { ...newPembagianKelas[kelasIdx] };
                    const targetList = [...(targetKelas[semesterType] || [])];

                    const [item] = targetList.splice(currentItemIdx, 1);
                    targetList.splice(targetItemIdx, 0, item);

                    targetKelas[semesterType] = targetList;
                    
                    let currentUrutan = 1;
                    if (targetKelas.semester_ganjil) targetKelas.semester_ganjil.forEach(item => item.urutan = currentUrutan++);
                    if (targetKelas.semester_genap) targetKelas.semester_genap.forEach(item => item.urutan = currentUrutan++);

                    newPembagianKelas[kelasIdx] = targetKelas;
                    newResult.pembagian_kelas = newPembagianKelas;
                    return newResult;
                });
            };

            const handleKelasChange = (currentKelasIdx, currentSemester, itemIdx, targetKelasIdx) => {
                if (currentKelasIdx === targetKelasIdx) return;
                setResult(prevResult => {
                    if (!prevResult) return prevResult;
                    const newResult = { ...prevResult };
                    const newPembagianKelas = [...newResult.pembagian_kelas];
                    
                    const sourceKelas = { ...newPembagianKelas[currentKelasIdx] };
                    const targetKelas = { ...newPembagianKelas[targetKelasIdx] };
                    
                    if (!sourceKelas[currentSemester] || sourceKelas[currentSemester].length <= itemIdx) return prevResult;

                    const itemToMove = sourceKelas[currentSemester][itemIdx];
                    sourceKelas[currentSemester] = sourceKelas[currentSemester].filter((_, i) => i !== itemIdx);
                    
                    if (!targetKelas[currentSemester]) targetKelas[currentSemester] = [];
                    targetKelas[currentSemester] = [...targetKelas[currentSemester], itemToMove];

                    [sourceKelas, targetKelas].forEach(kelas => {
