                                        className="w-full p-3 border border-slate-700 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none shadow-md bg-[#0f172a] text-white"
                                    >
                                        <option value="Alternatif 1 (Langsung berdasarkan kalimat CP)" className="bg-[#111c33]">Alternatif 1: Rumuskan Langsung dari CP</option>
                                        <option value="Alternatif 2 (Analisis Kompetensi & Konten)" className="bg-[#111c33]">Alternatif 2: Analisis Kompetensi & Konten</option>
                                        <option value="Alternatif 3 (Lintas Elemen CP)" className="bg-[#111c33]">Alternatif 3: Penggabungan Lintas Elemen CP</option>
                                    </select>
                                </div>

                                <div className="mb-4">
                                    <label className="block text-sm font-semibold text-blue-100 mb-2">Metode Pengurutan ATP</label>
                                    <select 
                                        value={metodePengurutan}
                                        onChange={(e) => setMetodePengurutan(e.target.value)}
                                        className="w-full p-3 border border-slate-700 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 outline-none shadow-md bg-[#0f172a] text-white"
                                    >
                                        <option value="Otomatis (Diserahkan ke AI)" className="bg-[#111c33]">Otomatis (AI memilih metode yang paling sesuai)</option>
                                        <option value="Konkret ke Abstrak" className="bg-[#111c33]">Konkret ke Abstrak (Dari konsep berwujud ke simbolis/abstrak)</option>
                                        <option value="Deduktif" className="bg-[#111c33]">Deduktif (Dari konsep umum/luas ke spesifik)</option>
                                        <option value="Mudah ke Sulit" className="bg-[#111c33]">Mudah ke Sulit (Dari konten mudah ke konten paling sulit)</option>
                                        <option value="Hierarki" className="bg-[#111c33]">Hierarki (Keterampilan dasar/mudah diajarkan sebelum yang kompleks)</option>
                                        <option value="Prosedural" className="bg-[#111c33]">Prosedural (Mengajarkan tahapan berurutan / SOP)</option>
                                        <option value="Scaffolding" className="bg-[#111c33]">Scaffolding (Tingkat performa naik dengan pengurangan bantuan perlahan)</option>
                                    </select>
                                </div>

                                <label className="block text-sm font-semibold text-blue-100 mb-2 flex items-center gap-2">
                                    <BookOpenIcon /> Masukkan Teks CP
                                </label>
                                <textarea
                                    className="w-full h-40 p-3 mb-2 border border-slate-700 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none resize-none text-sm text-white bg-[#0f172a] custom-scrollbar shadow-inner placeholder-slate-500"
                                    placeholder="Salin (copy) paragraf Capaian Pembelajaran dari dokumen resmi Kurikulum Merdeka dan tempel (paste) di sini..."
                                    value={cpInput}
                                    onChange={(e) => setCpInput(e.target.value)}
                                ></textarea>
                                
                                <div className="mb-4 inline-flex items-start gap-2 px-3 py-2.5 rounded-lg bg-indigo-950/50 border border-indigo-500/30 text-xs font-medium text-indigo-200 w-full leading-tight">
                                    <div className="mt-0.5 text-indigo-400"><SparklesIcon /></div>
                                    <div>Sistem AI akan otomatis memetakan & memperkaya <b>Materi Esensial</b> sesuai pedoman {mataPelajaran} {fase}.</div>
                                </div>
                                
                                <div className="mt-1 flex justify-end">
                                    <button 
                                        onClick={() => setCpInput(defaultCP)}
                                        className="text-xs text-primary-400 hover:text-primary-300 underline font-medium"
                                    >
                                        Gunakan Contoh CP Matematika
                                    </button>
                                </div>

                                <button
                                    onClick={generateATP}
                                    disabled={isGenerating}
                                    className={`w-full mt-4 py-3 px-4 bg-primary-600 hover:bg-primary-700 text-white rounded-xl font-semibold transition-all duration-200 flex items-center justify-center gap-2 ${isGenerating ? 'opacity-80 cursor-not-allowed' : 'shadow-lg shadow-primary-500/30'}`}
                                >
                                    {isGenerating ? (
                                        <span className="pulse-dots">Menganalisis dengan AI</span>
                                    ) : (
                                        <>Mulai Buat ATP <TargetIcon /></>
                                    )}
                                </button>
                                
                                {error && (
                                    <div className="mt-4 p-3 bg-red-950/50 border border-red-500/30 text-red-200 text-sm rounded-lg flex gap-2 items-start">
                                        <div className="mt-0.5"><AlertCircleIcon /></div>
                                        <p>{error}</p>
                                    </div>
                                )}
                            </div>

                        </div>

                        {/* Result Section */}
                        <div className="col-span-1 lg:col-span-8">
                            <div className="glass-panel rounded-2xl overflow-hidden min-h-[600px] flex flex-col">
                                
                                <div className="flex border-b border-slate-700 bg-[#111c33]/50">
                                    <button 
                                        onClick={() => setActiveTab("analisis")}
                                        className={`flex-1 py-4 text-sm font-semibold transition-colors flex justify-center items-center gap-2 ${activeTab === 'analisis' ? 'text-primary-400 border-b-2 border-primary-500 bg-[#1c2541]' : 'text-slate-400 hover:text-white hover:bg-[#111c33]'}`}
                                    >
                                        1. Analisis CP
                                    </button>
                                    <button 
                                        onClick={() => setActiveTab("tp")}
                                        className={`flex-1 py-4 text-sm font-semibold transition-colors flex justify-center items-center gap-2 ${activeTab === 'tp' ? 'text-primary-400 border-b-2 border-primary-500 bg-[#1c2541]' : 'text-slate-400 hover:text-white hover:bg-[#111c33]'}`}
                                    >
                                        2. Rumusan TP
                                    </button>
                                    <button 
                                        onClick={() => setActiveTab("alur")}
                                        className={`flex-1 py-4 text-sm font-semibold transition-colors flex justify-center items-center gap-2 ${activeTab === 'alur' ? 'text-primary-400 border-b-2 border-primary-500 bg-[#1c2541]' : 'text-slate-400 hover:text-white hover:bg-[#111c33]'}`}
                                    >
                                        3. Susunan ATP
                                    </button>
                                </div>

                                <div className="p-6 flex-grow bg-[#111c33]">
                                    {!result && !isGenerating && (
                                        <div className="h-full flex flex-col items-center justify-center text-slate-400">
                                            <ListOrderedIcon />
                                            <p className="mt-4 text-sm text-center px-6 text-slate-300">Identitas tersimpan. Masukkan CP dan klik "Mulai Buat ATP" di sebelah kiri untuk menghasilkan dokumen Anda.</p>
                                        </div>
                                    )}

                                    {isGenerating && (
                                        <div className="animate-pulse space-y-6">
                                            <div className="h-8 bg-slate-800 rounded w-1/3"></div>
                                            <div className="space-y-3">
                                                <div className="h-4 bg-slate-800 rounded"></div>
                                                <div className="h-4 bg-slate-800 rounded w-5/6"></div>
                                                <div className="h-4 bg-slate-800 rounded w-4/6"></div>
                                            </div>
                                            <div className="h-8 bg-slate-800 rounded w-1/4 mt-8"></div>
                                            <div className="space-y-3">
                                                <div className="h-20 bg-slate-800 rounded-xl"></div>
                                                <div className="h-20 bg-slate-800 rounded-xl"></div>
                                            </div>
                                        </div>
                                    )}

                                    {result && !isGenerating && activeTab === "analisis" && (
                                        <div className="space-y-6 animation-fade-in">
                                            <h2 className="text-xl font-bold text-white border-l-4 border-primary-500 pl-3">Dekomposisi Capaian Pembelajaran</h2>
                                            <p className="text-sm text-blue-200 mb-4">Pemetaan antara keterampilan (kompetensi) yang harus dikuasai dan materi pelajaran (konten).</p>
                                            
                                            <div className="grid md:grid-cols-2 gap-6">
                                                <div className="bg-[#1c2541] border border-blue-900 rounded-xl p-5">
                                                    <h3 className="font-semibold text-blue-300 mb-3 flex items-center gap-2">
                                                        <span className="w-6 h-6 rounded-full bg-blue-900/50 flex items-center justify-center text-xs text-blue-300">⚡</span>
                                                        Kompetensi (Kata Kerja)
                                                    </h3>
                                                    <ul className="space-y-2">
                                                        {result.analisis.kompetensi.map((item, idx) => (
                                                            <li key={idx} className="text-sm text-blue-100 bg-[#0f172a] py-2 px-3 rounded-lg border border-slate-700 shadow-sm capitalize">{item}</li>
                                                        ))}
                                                    </ul>
                                                </div>
                                                <div className="bg-[#1c2541] border border-emerald-900 rounded-xl p-5">
                                                    <h3 className="font-semibold text-emerald-300 mb-3 flex items-center gap-2">
                                                        <span className="w-6 h-6 rounded-full bg-emerald-900/50 flex items-center justify-center text-xs text-emerald-300">📚</span>
                                                        Lingkup Materi (Konten)
                                                    </h3>
                                                    <ul className="space-y-2">
                                                        {result.analisis.konten.map((item, idx) => (
                                                            <li key={idx} className="text-sm text-emerald-100 bg-[#0f172a] py-2 px-3 rounded-lg border border-slate-700 shadow-sm capitalize">{item}</li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    )}

                                    {result && !isGenerating && activeTab === "tp" && (
                                        <div className="space-y-6 animation-fade-in">
                                            <div className="flex justify-between items-end">
                                                <div>
                                                    <h2 className="text-xl font-bold text-white border-l-4 border-primary-500 pl-3">Daftar Tujuan Pembelajaran</h2>
                                                    <p className="text-sm text-blue-200 mt-1">Dirumuskan dengan mematuhi aturan <b>1 Tujuan Pembelajaran = 1 Lingkup Materi Esensial</b>.</p>
                                                </div>
                                            </div>

                                            <div className="space-y-3">
                                                {result.tujuan_pembelajaran.map((tp, idx) => (
                                                    <div key={idx} className="flex gap-4 p-5 rounded-xl border border-slate-700 bg-[#1c2541] shadow-md hover:shadow-lg transition-all">
                                                        <div className="flex-shrink-0 w-10 h-10 rounded-full bg-primary-900/50 text-primary-300 flex items-center justify-center font-bold text-lg border border-primary-500/40">
                                                            {idx + 1}
                                                        </div>
                                                        <div className="flex-grow pt-1">
                                                            <p className="text-[15px] text-slate-100 font-semibold leading-relaxed mb-3">{tp.teks_tp || tp}</p>
                                                            
                                                            {tp.kompetensi && tp.lingkup_materi && (
                                                                <div className="flex flex-wrap gap-2 text-[11px] font-medium">
                                                                    <div className="flex items-center gap-1.5 px-2.5 py-1 bg-blue-950/60 text-blue-300 border border-blue-900 rounded-lg">
                                                                        <span className="text-blue-400">⚡</span> Kompetensi: {tp.kompetensi}
                                                                    </div>
                                                                    <div className="flex items-center gap-1.5 px-2.5 py-1 bg-emerald-950/60 text-emerald-300 border border-emerald-900 rounded-lg">
                                                                        <span className="text-emerald-400">📚</span> Lingkup Materi: {tp.lingkup_materi}
                                                                    </div>
                                                                </div>
                                                            )}
                                                        </div>
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    )}

                                    {result && !isGenerating && activeTab === "alur" && (
                                        <div className="space-y-6 animation-fade-in">
                                            <div className="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-slate-700 pb-4">
                                                <div>
                                                    <h2 className="text-xl font-bold text-white border-l-4 border-primary-500 pl-3">Alur Tujuan Pembelajaran (ATP)</h2>
                                                    <p className="text-sm text-blue-200 mt-1">Pembagian dan urutan logis TP berdasarkan kelas.</p>
                                                </div>
                                                <div className="flex flex-col items-end">
                                                    <div className="flex flex-wrap gap-2">
                                                        <button 
                                                            onClick={handleCopy}
                                                            className="flex items-center gap-2 text-xs font-semibold px-4 py-2.5 bg-slate-800 text-slate-100 border border-slate-600 rounded-lg hover:bg-slate-700 transition-colors shadow-md"
                                                        >
                                                            {copied ? <><CheckIcon /> Tersalin!</> : <><CopyIcon /> Salin Teks</>}
                                                        </button>
                                                        <button 
                                                            onClick={exportToWord}
                                                            className="flex items-center gap-2 text-xs font-semibold px-4 py-2.5 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors shadow-lg shadow-primary-500/20"
                                                        >
                                                            <DownloadIcon /> Unduh Word (A4)
                                                        </button>
                                                    </div>
                                                    {copyErrorMsg && (
                                                        <p className="text-[10px] text-red-400 mt-2 font-medium bg-red-950/50 px-2 py-1 rounded border border-red-500/30">{copyErrorMsg}</p>
                                                    )}
                                                </div>
                                            </div>

                                            <div className="space-y-10 mt-6">
                                                {result.pembagian_kelas && result.pembagian_kelas.map((kelasItem, kelasIdx) => (
                                                    <div key={kelasIdx} className="bg-[#1c2541]/50 rounded-2xl p-5 border border-slate-700 shadow-inner">
                                                        <h3 className="text-lg font-bold text-primary-300 mb-6 pb-3 border-b-2 border-slate-700 flex items-center gap-2">
                                                            <span className="bg-primary-900/50 text-primary-300 p-1.5 rounded-md border border-primary-500/30"><ListOrderedIcon /></span>
                                                            Peruntukan: {kelasItem.kelas}
                                                        </h3>
                                                        
                                                        {/* SEMESTER GANJIL */}
                                                        {kelasItem.semester_ganjil && kelasItem.semester_ganjil.length > 0 && (
                                                            <div className="mb-8">
                                                                <h4 className="inline-block bg-orange-950/50 text-orange-300 text-sm font-bold px-3 py-1.5 rounded-lg mb-4 border border-orange-500/30 shadow-md">
                                                                    SEMESTER GANJIL
                                                                </h4>
                                                                <div className="relative border-l-2 border-orange-500/40 ml-4 pl-6 space-y-8">
                                                                    {kelasItem.semester_ganjil.map((item, idx) => (
                                                                        <div key={idx} className="relative">
                                                                            <div className="absolute -left-[35px] top-1 w-6 h-6 rounded-full bg-[#111c33] border-4 border-orange-500 z-10"></div>
                                                                            <div className="bg-[#1c2541] border border-slate-700 rounded-xl p-5 shadow-md hover:shadow-lg transition-shadow relative">
                                                                                <div className="absolute top-0 right-0 flex flex-wrap items-center bg-[#0f172a] text-slate-300 rounded-bl-xl rounded-tr-xl border-l border-b border-slate-700 overflow-hidden shadow-sm z-20">
                                                                                    <div className="flex items-center px-2 py-1.5 border-r border-slate-700 hover:bg-slate-900 transition-colors">
                                                                                        <select 
                                                                                            value={kelasIdx} 
                                                                                            onChange={(e) => handleKelasChange(kelasIdx, 'semester_ganjil', idx, parseInt(e.target.value))}
                                                                                            className="text-[10px] font-bold uppercase tracking-wider bg-transparent outline-none cursor-pointer max-w-[80px] md:max-w-[120px] truncate text-white"
                                                                                        >
                                                                                            {result.pembagian_kelas.map((k, kIdx) => (
                                                                                                <option key={kIdx} value={kIdx} className="bg-[#111c33]">{k.kelas}</option>
                                                                                            ))}
                                                                                        </select>
                                                                                    </div>
                                                                                    <div className="flex items-center px-2 py-1.5 border-r border-slate-700 hover:bg-slate-900 transition-colors">
                                                                                        <select 
                                                                                            value="semester_ganjil" 
                                                                                            onChange={(e) => handleSemesterChange(kelasIdx, 'semester_ganjil', e.target.value, idx)}
                                                                                            className="text-[10px] font-bold uppercase tracking-wider bg-transparent outline-none cursor-pointer text-white"
                                                                                        >
                                                                                            <option value="semester_ganjil" className="bg-[#111c33]">Ganjil</option>
                                                                                            <option value="semester_genap" className="bg-[#111c33]">Genap</option>
                                                                                        </select>
                                                                                    </div>
                                                                                    <div className="flex items-center px-2 py-1.5 bg-[#0a101f] hover:bg-slate-900 transition-colors">
                                                                                        <span className="text-[10px] font-bold uppercase tracking-wider mr-1 text-slate-400">Urutan:</span>
                                                                                        <select 
                                                                                            value={idx}
                                                                                            onChange={(e) => handleOrderChange(kelasIdx, 'semester_ganjil', idx, parseInt(e.target.value))}
                                                                                            className="text-[11px] font-bold bg-transparent outline-none cursor-pointer text-orange-400"
                                                                                        >
                                                                                            {kelasItem.semester_ganjil.map((_, i) => (
                                                                                                <option key={i} value={i} className="bg-[#111c33]">{i + 1}</option>
                                                                                            ))}
                                                                                        </select>
                                                                                    </div>
                                                                                </div>
                                                                                <h4 className="font-semibold text-slate-100 text-sm mb-2 pr-[240px] leading-relaxed mt-4 md:mt-0">{item.tp}</h4>
                                                                                <div className="mt-4 pt-3 border-t border-slate-700 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                                                                                    <div>
                                                                                        <span className="text-slate-400 font-medium block mb-1">Metode Pengurutan:</span>
                                                                                        <span className="inline-block bg-slate-800 text-slate-300 px-2 py-1 rounded font-medium border border-slate-700">{item.metode_pengurutan}</span>
                                                                                    </div>
                                                                                    <div>
                                                                                        <span className="text-slate-400 font-medium block mb-1">Rasional & Alasan:</span>
                                                                                        <p className="text-slate-300 leading-relaxed bg-[#0f172a] p-2 rounded border border-slate-800">{item.rasional}</p>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    ))}
                                                                </div>
                                                            </div>
                                                        )}

                                                        {/* SEMESTER GENAP */}
                                                        {kelasItem.semester_genap && kelasItem.semester_genap.length > 0 && (
                                                            <div>
                                                                <h4 className="inline-block bg-blue-950/50 text-blue-300 text-sm font-bold px-3 py-1.5 rounded-lg mb-4 border border-blue-500/30 shadow-md">
                                                                    SEMESTER GENAP
                                                                </h4>
                                                                <div className="relative border-l-2 border-blue-500/40 ml-4 pl-6 space-y-8">
                                                                    {kelasItem.semester_genap.map((item, idx) => (
                                                                        <div key={idx} className="relative">
                                                                            <div className="absolute -left-[35px] top-1 w-6 h-6 rounded-full bg-[#111c33] border-4 border-blue-500 z-10"></div>
                                                                            <div className="bg-[#1c2541] border border-slate-700 rounded-xl p-5 shadow-md hover:shadow-lg transition-shadow relative">
                                                                                <div className="absolute top-0 right-0 flex flex-wrap items-center bg-[#0f172a] text-slate-300 rounded-bl-xl rounded-tr-xl border-l border-b border-slate-700 overflow-hidden shadow-sm z-20">
                                                                                    <div className="flex items-center px-2 py-1.5 border-r border-slate-700 hover:bg-slate-900 transition-colors">
                                                                                        <select 
                                                                                            value={kelasIdx} 
                                                                                            onChange={(e) => handleKelasChange(kelasIdx, 'semester_genap', idx, parseInt(e.target.value))}
                                                                                            className="text-[10px] font-bold uppercase tracking-wider bg-transparent outline-none cursor-pointer max-w-[80px] md:max-w-[120px] truncate text-white"
                                                                                        >
                                                                                            {result.pembagian_kelas.map((k, kIdx) => (
                                                                                                <option key={kIdx} value={kIdx} className="bg-[#111c33]">{k.kelas}</option>
                                                                                            ))}
                                                                                        </select>
                                                                                    </div>
                                                                                    <div className="flex items-center px-2 py-1.5 border-r border-slate-700 hover:bg-slate-900 transition-colors">
                                                                                        <select 
                                                                                            value="semester_genap" 
                                                                                            onChange={(e) => handleSemesterChange(kelasIdx, 'semester_genap', e.target.value, idx)}
                                                                                            className="text-[10px] font-bold uppercase tracking-wider bg-transparent outline-none cursor-pointer text-white"
                                                                                        >
                                                                                            <option value="semester_ganjil" className="bg-[#111c33]">Ganjil</option>
                                                                                            <option value="semester_genap" className="bg-[#111c33]">Genap</option>
                                                                                        </select>
                                                                                    </div>
                                                                                    <div className="flex items-center px-2 py-1.5 bg-[#0a101f] hover:bg-slate-900 transition-colors">
                                                                                        <span className="text-[10px] font-bold uppercase tracking-wider mr-1 text-slate-400">Urutan:</span>
                                                                                        <select 
                                                                                            value={idx}
                                                                                            onChange={(e) => handleOrderChange(kelasIdx, 'semester_genap', idx, parseInt(e.target.value))}
                                                                                            className="text-[11px] font-bold bg-transparent outline-none cursor-pointer text-primary-400"
                                                                                        >
                                                                                            {kelasItem.semester_genap.map((_, i) => (
                                                                                                <option key={i} value={i} className="bg-[#111c33]">{i + 1}</option>
                                                                                            ))}
                                                                                        </select>
                                                                                    </div>
                                                                                </div>
                                                                                <h4 className="font-semibold text-slate-100 text-sm mb-2 pr-[240px] leading-relaxed mt-4 md:mt-0">{item.tp}</h4>
                                                                                <div className="mt-4 pt-3 border-t border-slate-700 grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                                                                                    <div>
                                                                                        <span className="text-slate-400 font-medium block mb-1">Metode Pengurutan:</span>
                                                                                        <span className="inline-block bg-slate-800 text-slate-300 px-2 py-1 rounded font-medium border border-slate-700">{item.metode_pengurutan}</span>
                                                                                    </div>
                                                                                    <div>
                                                                                        <span className="text-slate-400 font-medium block mb-1">Rasional & Alasan:</span>
                                                                                        <p className="text-slate-300 leading-relaxed bg-[#0f172a] p-2 rounded border border-slate-800">{item.rasional}</p>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    ))}
                                                                </div>
                                                            </div>
                                                        )}
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    )}

                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
